{
  "name": "langfuse-lite",
  "version": "0.1.0",
  "description": "A tiny local Langfuse for experiment runs and agent tracing: one process, one SQLite file, the Langfuse SDKs unchanged.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "langfuse-lite": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/THIRD_PARTY_NOTICES.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:bin": "bun run scripts/build.ts --compile",
    "typecheck": "tsc -p .",
    "test": "bun test test/",
    "conformance": ".venv-test/bin/python test/conformance.py",
    "vendor": "scripts/vendor-langfuse.sh",
    "prepack": "bun run scripts/build.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "22.19.1",
    "decimal.js": "10.6.0",
    "lodash": "4.18.1",
    "lossless-json": "4.1.1",
    "typescript": "^5.9.3",
    "zod": "4.6.6"
  },
  "keywords": [
    "langfuse",
    "llm",
    "observability",
    "tracing",
    "opentelemetry",
    "evals",
    "experiments",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langfuse/langfuse-lite.git",
    "directory": "slim"
  }
}
